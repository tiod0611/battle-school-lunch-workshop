# NEIS Open API 인증키 (https://open.neis.go.kr 에서 발급, 필수)
NEIS_API_KEY=your_neis_api_key_here

# 백엔드가 허용할 프론트엔드 오리진 (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# 프론트엔드가 호출할 백엔드 주소 (브라우저에서 접근 가능한 주소)
VITE_API_BASE_URL=http://localhost:8000

# 백엔드 SQLite DB 파일 경로 (컨테이너/로컬 기준 상대경로)
DATABASE_PATH=./data/app.db

# 오늘의 왕 배치 실행 시각 (0~23시, 0~59분 기준, 매일 1회 실행)
TOURNAMENT_RUN_HOUR=0
TOURNAMENT_RUN_MINUTE=10
